{
  "name": "mongodb-mcp-runtime",
  "version": "1.0.0",
  "description": "AgentCore Runtime MCP server exposing MongoDB Atlas tools (mongodb_query, mongodb_vector_search, mongodb_aggregate). Serves Streamable-HTTP MCP on 0.0.0.0:8000/mcp per the AgentCore runtime contract; consumed by AgentCore Gateway via an `mcpServer` target. Sole MongoDB MCP host after CLIENT_REVIEW Phase 7e (P1-1 / P1-2 satisfied).",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "express": "^5.3.0",
    "mongodb": "^6.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.6",
    "fast-uri": "3.1.9",
    "body-parser": "2.4.0",
    "qs": "6.17.1"
  }
}
