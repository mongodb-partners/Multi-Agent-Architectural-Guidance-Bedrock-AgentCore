{
  "name": "multi-agent-api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:agentcore-code": "esbuild src/agent-runtime-code.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/agent-runtime-code.js",
    "validate:bun": "bun run scripts/validate-bun-compat.ts",
    "validate:agentcore": "bun run scripts/validate-agentcore-memory.ts",
    "validate:strands-otel": "bun run scripts/validate-strands-otel.ts",
    "validate:strands-retries": "bun run scripts/validate-strands-retries.ts",
    "validate:strands-tools": "bun run scripts/validate-strands-tool-schema.ts",
    "voyage:print": "bun run scripts/voyage-print.ts",
    "validate:multi-classifier": "bun run scripts/validate-multi-classifier.ts",
    "bench:ttfb": "bun run scripts/bench-chat-ttfb.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:all": "bun test tests/unit tests/integration"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1161.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1161.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1161.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
    "@aws-sdk/client-lambda": "^3.1161.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.1161.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5",
    "@smithy/types": "^4.19.0",
    "@smithy/util-retry": "^4.6.2",
    "@strands-agents/sdk": "^0.7.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "mongodb": "^6.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.6",
    "fast-uri": "3.1.9",
    "js-yaml": "3.15.2",
    "protobufjs": "7.6.6",
    "body-parser": "2.4.0",
    "qs": "6.17.1"
  }
}
